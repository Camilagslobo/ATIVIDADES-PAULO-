algoritmo "CADASTRO DE ALUNO"

var
  nomeAluno: caracter
  qtdAluno: inteiro
  contador: inteiro
  nomaesAlunos: vetor [1..10] de caracter

inicio

  contador <- 1
  escreval("INSIRA A QUANTIDADE DE ALUNOS")
  Leia(qtdAluno)

  para contador de 1 ate qtdAluno faca 
  escreval("INSIRA O NOME DO ", contador, "º ALUNO ")
  Leia(nomeAluno)
  nomeAluno [contador] <- nomeAluno
  fimpara 

  contador <-1 

  para contador de 1 ate 10 faca 
  escreval(nomeAluno[contador])
  fimpara 

fimalgoritmo
